{
  "name": "vscode-bilibili-player",
  "displayName": "vscode-bilibili-player",
  "description": "把 B 站视频铺在 VS Code 编辑区背景层播放，边写代码边看视频（支持直播、弹幕、小屏模式）。",
  "version": "0.7.4",
  "packageManager": "pnpm@10.32.1",
  "icon": "media/logo.png",
  "publisher": "YangZheng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhostFace-yz/vscode_bilibili_player.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "bilibili",
    "video",
    "background",
    "skin",
    "player",
    "哔哩哔哩"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bilibiliPlayer.enable",
        "title": "开启",
        "category": "B站皮肤"
      },
      {
        "command": "bilibiliPlayer.disable",
        "title": "关闭（还原工作台）",
        "category": "B站皮肤"
      },
      {
        "command": "bilibiliPlayer.showOutput",
        "title": "打开控制台",
        "category": "B站皮肤"
      }
    ],
    "keybindings": [
      {
        "command": "bilibiliPlayer.enable",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "bilibiliPlayer.disable",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b"
      }
    ],
    "configuration": {
      "title": "Bilibili 视频皮肤",
      "properties": {
        "bilibiliPlayer.defaultVideo": {
          "type": "string",
          "default": "",
          "description": "默认播放的视频：BV 号、av 号或 B 站视频链接。",
          "order": 1
        },
        "bilibiliPlayer.opacity": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.05,
          "maximum": 1,
          "description": "视频层不透明度。",
          "order": 2
        },
        "bilibiliPlayer.blur": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 40,
          "description": "视频层模糊半径（px）。",
          "order": 3
        },
        "bilibiliPlayer.dim": {
          "type": "number",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1,
          "description": "视频上方的暗化层强度。暗化色使用当前 VS Code 主题的编辑器背景色；100% 时画面完全回到原编辑区颜色。",
          "order": 4
        },
        "bilibiliPlayer.hiddenMode": {
          "type": "boolean",
          "default": false,
          "description": "隐藏播放模式：关闭时视频始终按透明度/模糊/暗化显示；开启后只有鼠标悬停 HUD 时才显示视频，移开则暗化 100%、透明 0%。",
          "order": 5
        },
        "bilibiliPlayer.fit": {
          "type": "string",
          "enum": [
            "full",
            "mini"
          ],
          "enumDescriptions": [
            "完整：按视频宽高比在编辑区完整显示，其余区域保留编辑器背景",
            "小屏：在编辑区里放一个可拖动/缩放的小窗口"
          ],
          "default": "full",
          "description": "视频在编辑区里的显示方式。",
          "order": 5
        },
        "bilibiliPlayer.miniRect": {
          "type": "object",
          "default": {
            "x": 0.62,
            "y": 0.55,
            "w": 0.32
          },
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "w": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            }
          },
          "additionalProperties": false,
          "description": "小屏模式下视频框的位置和宽度（相对编辑区可用区域的 0-1 比例，高度按视频宽高比自动计算）。一般通过 HUD 的「小屏设置」拖动调整。",
          "order": 5
        },
        "bilibiliPlayer.danmakuAutoScroll": {
          "type": "boolean",
          "default": true,
          "description": "弹幕输出自动滚动：开启后会把 VS Code 的 output.smartScroll.enabled 关掉（智能滚动会让输出面板在点击后停止跟随），保证弹幕一直滚到底部。",
          "order": 5
        },
        "bilibiliPlayer.danmaku": {
          "type": "boolean",
          "default": false,
          "description": "弹幕：打开后会把视频当前的弹幕按播放时间逐条打印到「Bilibili 皮肤」输出面板。",
          "order": 5
        },
        "bilibiliPlayer.cropBars": {
          "type": "boolean",
          "default": true,
          "description": "移除黑边：用 ffmpeg 探测视频画面的真实宽高比，按内容比例排布并裁掉视频自带的黑边。关闭后按视频原始宽高比显示（黑边保留）。",
          "order": 5
        },
        "bilibiliPlayer.muted": {
          "type": "boolean",
          "default": true,
          "description": "静音播放。",
          "order": 6
        },
        "bilibiliPlayer.autoplay": {
          "type": "boolean",
          "default": true,
          "description": "打开后自动播放。",
          "order": 7
        },
        "bilibiliPlayer.quality": {
          "type": "number",
          "default": 80,
          "enum": [
            16,
            32,
            64,
            74,
            80,
            112,
            116,
            120
          ],
          "enumDescriptions": [
            "360P",
            "480P",
            "720P",
            "720P60",
            "1080P",
            "1080P+",
            "1080P60",
            "4K"
          ],
          "description": "期望清晰度（实际可用清晰度取决于账号与视频源）。",
          "order": 8
        },
        "bilibiliPlayer.audioCacheMaxMb": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 4096,
          "description": "音频缓存上限（MB）。播放过的视频音轨会转码缓存下来，超出后按时间删除最旧的（至少保留最新一个）。0 表示只保留当前这个视频的缓存。",
          "order": 6
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:skin": "tailwindcss -i src/skin/tailwind.css -o dist/skin.css --minify",
    "compile": "node esbuild.js && pnpm run build:skin",
    "watch": "concurrently -k -n esbuild,tailwind -c blue,magenta \"node esbuild.js --watch\" \"tailwindcss -i src/skin/tailwind.css -o dist/skin.css --watch\"",
    "dev": "pnpm run watch",
    "dev:server": "esbuild scripts/dev-server.ts --bundle --platform=node --format=cjs --outfile=dist/dev-server.cjs --target=node20 && node dist/dev-server.cjs",
    "package": "node esbuild.js --production && pnpm run build:skin",
    "vsix": "pnpm run package && vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run package",
    "vsix:store": "node scripts/pack-store.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@ricons/fluent": "^0.13.0",
    "@ricons/material": "^0.13.0",
    "@ricons/tabler": "^0.13.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.0",
    "gsap": "^3.15.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0"
  }
}
