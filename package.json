{
  "name": "vscode-bilibili-player",
  "displayName": "Bilibili 视频皮肤",
  "description": "把 B 站视频铺在 VS Code 工作台背景层播放，边写代码边看视频。",
  "version": "0.4.11",
  "packageManager": "pnpm@10.32.1",
  "icon": "media/logo.png",
  "publisher": "GhostFace-yz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhostFace-yz/vscode_bilibili_player.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "bilibili",
    "video",
    "background",
    "skin",
    "player",
    "哔哩哔哩"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bilibiliPlayer.play",
        "title": "B站皮肤: 播放视频…",
        "category": "Bilibili Player"
      },
      {
        "command": "bilibiliPlayer.toggle",
        "title": "B站皮肤: 显示/隐藏皮肤",
        "category": "Bilibili Player"
      },
      {
        "command": "bilibiliPlayer.login",
        "title": "B站皮肤: 扫码登录",
        "category": "Bilibili Player"
      },
      {
        "command": "bilibiliPlayer.applySkin",
        "title": "B站皮肤: 应用皮肤（注入工作台）",
        "category": "Bilibili Player"
      },
      {
        "command": "bilibiliPlayer.restoreSkin",
        "title": "B站皮肤: 还原工作台",
        "category": "Bilibili Player"
      },
      {
        "command": "bilibiliPlayer.fixChecksums",
        "title": "B站皮肤: 修复校验和（消除安装损坏提示）",
        "category": "Bilibili Player"
      },
      {
        "command": "bilibiliPlayer.openPlayerPanel",
        "title": "B站皮肤: 在编辑器区域打开播放器(安全模式)",
        "category": "Bilibili Player"
      },
      {
        "command": "bilibiliPlayer.showLog",
        "title": "B站皮肤: 显示日志",
        "category": "Bilibili Player"
      }
    ],
    "keybindings": [
      {
        "command": "bilibiliPlayer.toggle",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "bilibiliPlayer.play",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b"
      }
    ],
    "configuration": {
      "title": "Bilibili 视频皮肤",
      "properties": {
        "bilibiliPlayer.defaultVideo": {
          "type": "string",
          "default": "",
          "description": "默认播放的视频：BV 号、av 号或 B 站视频链接。",
          "order": 1
        },
        "bilibiliPlayer.opacity": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.05,
          "maximum": 1,
          "description": "视频层不透明度。",
          "order": 2
        },
        "bilibiliPlayer.blur": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 40,
          "description": "视频层模糊半径（px）。",
          "order": 3
        },
        "bilibiliPlayer.dim": {
          "type": "number",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1,
          "description": "视频上方的暗化层强度。暗化色使用当前 VS Code 主题的编辑器背景色；100% 时画面完全回到原编辑区颜色。",
          "order": 4
        },
        "bilibiliPlayer.fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain",
            "fill"
          ],
          "default": "cover",
          "description": "视频铺满屏幕的方式。",
          "order": 5
        },
        "bilibiliPlayer.muted": {
          "type": "boolean",
          "default": true,
          "description": "静音播放。",
          "order": 6
        },
        "bilibiliPlayer.autoplay": {
          "type": "boolean",
          "default": true,
          "description": "打开后自动播放。",
          "order": 7
        },
        "bilibiliPlayer.quality": {
          "type": "number",
          "default": 80,
          "enum": [
            16,
            32,
            64,
            74,
            80,
            112,
            116,
            120
          ],
          "enumDescriptions": [
            "360P",
            "480P",
            "720P",
            "720P60",
            "1080P",
            "1080P+",
            "1080P60",
            "4K"
          ],
          "description": "期望清晰度（实际可用清晰度取决于账号与视频源）。",
          "order": 8
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:skin": "tailwindcss -i src/skin/tailwind.css -o dist/skin.css --minify",
    "compile": "node esbuild.js && pnpm run build:skin",
    "watch": "concurrently -k -n esbuild,tailwind -c blue,magenta \"node esbuild.js --watch\" \"tailwindcss -i src/skin/tailwind.css -o dist/skin.css --watch\"",
    "dev": "pnpm run watch",
    "dev:server": "esbuild scripts/dev-server.ts --bundle --platform=node --format=cjs --outfile=dist/dev-server.cjs --target=node20 && node dist/dev-server.cjs",
    "package": "node esbuild.js --production && pnpm run build:skin",
    "vsix": "pnpm run package && vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run package"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-select": "^2.4.1",
    "@ricons/tabler": "^0.13.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.0",
    "gsap": "^3.15.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0"
  }
}
